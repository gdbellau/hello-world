{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-cabal",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API and admin always go through the Worker; everything else is a free static hit.
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cabal",
      // Replace with the id printed by `wrangler d1 create cabal`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Your Zero Trust team domain and the AUD tag of the Access application protecting /admin.
    "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
  // Secrets (set with `wrangler secret put`): SESSION_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
}
